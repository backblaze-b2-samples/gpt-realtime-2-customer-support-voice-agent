{
  "name": "gpt-realtime-2-customer-support-voice-agent",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @gpt-realtime-2-customer-support-voice-agent/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @gpt-realtime-2-customer-support-voice-agent/web build",
    "typecheck": "pnpm --filter @gpt-realtime-2-customer-support-voice-agent/web typecheck",
    "lint": "pnpm --filter @gpt-realtime-2-customer-support-voice-agent/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @gpt-realtime-2-customer-support-voice-agent/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7": "7.29.6",
      "@hono/node-server@1": "1.19.15",
      "ajv@6": "6.14.0",
      "ajv@8": "8.20.0",
      "body-parser": "2.3.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.3",
      "express-rate-limit": "8.2.2",
      "fast-uri@3": "3.1.5",
      "flatted": "3.4.2",
      "hono": "4.13.13",
      "ip-address": "10.3.1",
      "js-yaml@4": "4.3.1",
      "lodash": "4.18.1",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "minimatch@10": "10.2.3",
      "nanoid@3": "3.3.18",
      "path-to-regexp@8": "8.4.0",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "postcss@8": "8.5.23",
      "postcss-selector-parser": "7.1.5",
      "qs": "6.15.2",
      "sharp": "0.35.3",
      "shell-quote": "1.9.0"
    }
  }
}
